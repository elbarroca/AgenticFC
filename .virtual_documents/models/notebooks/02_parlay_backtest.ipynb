    # Sort by Count
    print("\nMost Frequent Individual Leg Outcomes in Parlays:")
    display(leg_performance.sort_values(by='LegCount', ascending=False).head(20))

    # Optional: Filter for reliability
    min_leg_count_threshold = 500 # Example
    reliable_leg_performance = leg_performance[leg_performance['LegCount'] >= min_leg_count_threshold]
    print(f"\nTop Performing Individual Leg Outcomes (Occurring >= {min_leg_count_threshold} times):")
    display(reliable_leg_performance.sort_values(by='LegAccuracy', ascending=False).head(20))

