# In[10]:

# --- Analyze Contribution of Leg Types to Winning vs. Losing Parlays ---
print("\n--- Contribution of Leg Outcomes to Parlay Success ---")

if 'df_legs' in locals() and not df_legs.empty:
    # Count occurrences of each outcome in winning vs losing parlays
    outcome_contribution = df_legs.groupby(['Outcome', 'ParlayWon']).size().unstack(fill_value=0)
    outcome_contribution.rename(columns={False: 'CountInLosingParlays', True: 'CountInWinningParlays'}, inplace=True)

    # Calculate total times each outcome appeared in any parlay
    outcome_contribution['TotalCount'] = outcome_contribution['CountInLosingParlays'] + outcome_contribution['CountInWinningParlays']

    # Calculate the win rate *of parlays that contained this specific leg type*
    # Avoid division by zero
    outcome_contribution['ParlayWinRateWhenPresent'] = np.where(
        outcome_contribution['TotalCount'] > 0,
        (outcome_contribution['CountInWinningParlays'] / outcome_contribution['TotalCount']) * 100,
        0
    )

    # Filter out outcomes that appeared very few times
    min_total_count_threshold = 50 # Example threshold
    reliable_contribution = outcome_contribution[outcome_contribution['TotalCount'] >= min_total_count_threshold].copy()

    print(f"\nParlay Win Rate When Specific Leg Outcome Was Present (Min Count = {min_total_count_threshold}):")
    # Sort by the calculated win rate
    display(reliable_contribution.sort_values(by='ParlayWinRateWhenPresent', ascending=False).head(20))

    print(f"\nOutcomes Most Frequently Found in Winning Parlays (Min Count = {min_total_count_threshold}):")
    display(reliable_contribution.sort_values(by='CountInWinningParlays', ascending=False).head(20))

    print(f"\nOutcomes Most Frequently Found in Losing Parlays (Min Count = {min_total_count_threshold}):")
    display(reliable_contribution.sort_values(by='CountInLosingParlays', ascending=False).head(20))

else:
    print("ERROR: df_legs DataFrame not found or empty. Run previous cells.")


